# ════════════════════════════════════════
# SHOP EASY MONOREPO ENV TEMPLATE
# ════════════════════════════════════════

# ── LLM Configuration ─────────────────────
# Options: "openrouter" | "ollama"
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Required for docker-compose.yml)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Ollama Local Configuration (Required for docker-compose.local.yml)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b

# ── Security Secrets ──────────────────────
API_SECRET_KEY=preemptics-dev-secret-2026
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# ── App Ports ─────────────────────────────
STOREFRONT_PORT=8000
MEDUSA_PORT=9000
AGENT_PORT=4111

# ── External Integrations (Optional) ──────
# Google Calendar
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4111/auth/callback
GOOGLE_CALENDAR_ID=primary

# Gmail SMTP
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password
