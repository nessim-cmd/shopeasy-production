    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "seed:business": "tsx src/mastra/data/seedBusiness.ts",
    "seed:vector": "tsx src/mastra/data/seed.ts",
    "seed:knowledge": "tsx src/mastra/knowledge/seedKnowledge.ts",
    "seed:all": "npm run seed:business && npm run seed:vector && npm run seed:knowledge",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d",
    "dev:local": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml up -d",
    "dev:local:logs": "docker logs -f shop_app",
    "dev:local:down": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml down",
    "dev:local:restart": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml up -d --force-recreate app",
    "dev:gpu": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml -f docker-compose.gpu.yml up -d"
  },
